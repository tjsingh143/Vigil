#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
[[ $(uname -s) == Linux ]] || { echo 'Use ./scripts/dev ./scripts/check' >&2; exit 1; }
if [[ ${1:-} == --clean ]]; then
    # Fixed repository-local output directories only.
    rm -rf -- build build-sanitize
elif [[ $# != 0 ]]; then
    echo 'usage: scripts/check [--clean]' >&2; exit 1
fi
cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
cmake --build build --parallel 2
ctest --test-dir build --output-on-failure
.venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v
cmake -S . -B build-sanitize -DCMAKE_BUILD_TYPE=Debug -DVIGIL_SANITIZERS=ON
cmake --build build-sanitize --parallel 2
export ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
export UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
ctest --test-dir build-sanitize --output-on-failure
./scripts/vcan-up
.venv/bin/python tests/integration.py --decoder build/vigil-decode
.venv/bin/python tests/integration.py --decoder build-sanitize/vigil-decode
.venv/bin/python tests/monitor_integration.py --daemon build/vigild
.venv/bin/python tests/monitor_integration.py --daemon build-sanitize/vigild
