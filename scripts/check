#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
[[ $(uname -s) == Linux ]] || { echo 'Use ./scripts/dev ./scripts/check' >&2; exit 1; }
if [[ ${1:-} == --clean ]]; then
    # Fixed repository-local output directories only.
    rm -rf -- build build-sanitize build-tsan
elif [[ $# != 0 ]]; then
    echo 'usage: scripts/check [--clean]' >&2; exit 1
fi
printf 'EXPECT: strict clean build, 67 C cases in each build, Python tests and negative controls, real vcan/PostgreSQL/systemd regression, zero sanitizer/Helgrind findings.\n'
cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug
cmake --build build --parallel 2
ctest --test-dir build --output-on-failure
.venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v
cmake -S . -B build-sanitize -DCMAKE_BUILD_TYPE=Debug -DVIGIL_SANITIZERS=ON
cmake --build build-sanitize --parallel 2
export ASAN_OPTIONS=detect_leaks=1:halt_on_error=1
export UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1
ctest --test-dir build-sanitize --output-on-failure
./scripts/vcan-up
.venv/bin/python tests/integration.py --decoder build/vigil-decode
.venv/bin/python tests/integration.py --decoder build-sanitize/vigil-decode
.venv/bin/python tests/monitor_integration.py --daemon build/vigild
.venv/bin/python tests/monitor_integration.py --daemon build-sanitize/vigild

.venv/bin/python tests/resilience_integration.py --build build --output "artifacts/debug-outbox-$(date -u +%Y%m%dT%H%M%SZ)" --restarts 20
.venv/bin/python tests/resilience_storage.py --build build --output "artifacts/storage-outbox-$(date -u +%Y%m%dT%H%M%SZ)"
.venv/bin/python tests/resilience_integration.py --build build-sanitize --output "artifacts/asan-outbox-$(date -u +%Y%m%dT%H%M%SZ)" --restarts 2
cmake -S . -B build-tsan -DCMAKE_BUILD_TYPE=Debug -DVIGIL_TSAN=ON
cmake --build build-tsan --parallel 2
export TSAN_OPTIONS=halt_on_error=1
# GCC TSan on this ARM64 Ubuntu kernel needs a compatible address layout.
# Disable ASLR for this subprocess tree only, never change global VM settings.
setarch "$(uname -m)" -R ctest --test-dir build-tsan --output-on-failure
setarch "$(uname -m)" -R .venv/bin/python tests/resilience_integration.py --build build-tsan --output "artifacts/tsan-outbox-$(date -u +%Y%m%dT%H%M%SZ)" --restarts 2
valgrind --tool=helgrind --error-exitcode=99 --fair-sched=yes --suppressions=tests/helgrind.supp build/test_queue
for script in scripts/*; do bash -n "$script"; done
git diff --check

.venv/bin/python tests/resilience_database_contract.py
.venv/bin/python tests/resilience_replay.py --build build --output "artifacts/replay-$(date -u +%Y%m%dT%H%M%SZ)" --restarts 2
