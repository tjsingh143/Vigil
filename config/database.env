# libpq endpoint: an absolute Unix socket directory or numeric IP (no DNS).
VIGIL_DB_HOST=/var/run/postgresql
VIGIL_DB_PORT=5432
VIGIL_DB_NAME=vigil
VIGIL_DB_USER=vigil
# For TCP authentication, use PGPASSFILE pointing at a vigil-readable 0600 file.
# Standard libpq SSL settings may be supplied here. Never put passwords in CLI.
